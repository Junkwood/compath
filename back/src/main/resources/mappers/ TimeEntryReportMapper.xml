<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.report.mapper.TimeEntryReportMapper">

    <resultMap id="ReportMap" type="com.example.report.dto.TimeEntryReportDto">
        <result property="taskId"            column="TASK_ID"/>
        <result property="title"             column="TITLE"/>
        <result property="startDate"         column="START_DATE"/>
        <result property="dueDate"           column="DUE_DATE"/>
        <result property="progressRate"      column="PROGRESS_RATE"/>
        <result property="projectId"         column="PROJECT_ID"/>
        <result property="parentProjectName" column="PARENT_PROJECT_NAME"/>
        <result property="subProjectName"    column="SUB_PROJECT_NAME"/>
        <result property="projectName"       column="PROJECT_NAME"/>
        <result property="userId"            column="USER_ID"/>
        <result property="userName"          column="USER_NAME"/>
        <result property="taskTypeId"        column="TASK_TYPE_ID"/>
        <result property="typeName"          column="TYPE_NAME"/>
        <result property="totalHours"        column="TOTAL_HOURS"/>
        <result property="firstWorkDate"     column="FIRST_WORK_DATE"/>
        <result property="lastWorkDate"      column="LAST_WORK_DATE"/>
        <result property="entryCount"        column="ENTRY_COUNT"/>
    </resultMap>

    <resultMap id="AssigneeMap" type="com.example.report.dto.AssigneeDto">
        <result property="userId"   column="USER_ID"/>
        <result property="userName" column="USER_NAME"/>
    </resultMap>

    <resultMap id="TaskTypeMap" type="com.example.report.dto.TaskTypeDto">
        <result property="taskTypeId" column="TASK_TYPE_ID"/>
        <result property="typeName"   column="TYPE_NAME"/>
    </resultMap>

    <select id="getTimeEntryReport" statementType="CALLABLE">
        {
        CALL SP_GET_TIME_ENTRY_REPORT(
        #{projectId,       mode=IN,  jdbcType=NUMERIC},
        #{assigneeUserId,  mode=IN,  jdbcType=NUMERIC},
        #{taskTypeId,      mode=IN,  jdbcType=NUMERIC},
        #{keyword,         mode=IN,  jdbcType=VARCHAR},
        #{dateFrom,        mode=IN,  jdbcType=DATE},
        #{dateTo,          mode=IN,  jdbcType=DATE},
        #{reportList,      mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=ReportMap},
        #{assigneeList,    mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=AssigneeMap},
        #{taskTypeList,    mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=TaskTypeMap}
        )
        }
    </select>

</mapper>