<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.meeting.mapper.MeetingMapper">

<!--    회의유형 목록조회-->
    <select id="getMeetingType">
        SELECT code_value AS typeCode,
               code_name AS typeName
        FROM common_code
        WHERE group_value = '0N'
    </select>

</mapper>